					"_parent": {
						"$ref": "fZ9knYyxseQHJTzhMtc="
					},
					"name": "UC30 - Hold Work Pending Fingerprint Check (fingerprint check unfinished)",
					"documentation": "when the fingerprint service is down the platform keeps the work waiting and does not list it until the check is done",
					"visibility": "public",
					"isAbstract": false,
					"isFinalSpecialization": false,
					"isLeaf": false
				},
