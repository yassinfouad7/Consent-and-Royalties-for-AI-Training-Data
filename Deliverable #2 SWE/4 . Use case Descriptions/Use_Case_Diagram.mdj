						"$ref": "fZ9knYyxseQHJTzhMtc="
					},
					"name": "UC27 - Process Quarterly Royalties (every quarter)",
					"documentation": "every quarter the platform calculates royalties from licenses and buyer usage keeps 15 percent for the collective and pays creators in egp if they are in egypt or usd if they are abroad",
					"visibility": "public",
					"isAbstract": false,
					"isFinalSpecialization": false,
					"isLeaf": false
				},
