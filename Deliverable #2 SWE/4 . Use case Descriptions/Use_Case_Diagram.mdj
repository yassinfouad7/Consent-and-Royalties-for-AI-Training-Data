					"_type": "UMLUseCase",
					"_id": "EUkCGupg3X4/4a4M958=",
					"_parent": {
						"$ref": "fZ9knYyxseQHJTzhMtc="
					},
					"name": "UC39 - Calculate Usage-Based Royalties (usage report recorded)",
					"documentation": "when a buyer usage report is recorded the platform calculates the usage based part of the royalties for the works in that report",
