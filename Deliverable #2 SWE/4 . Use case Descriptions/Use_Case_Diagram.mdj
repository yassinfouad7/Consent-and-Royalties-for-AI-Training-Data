					"_parent": {
						"$ref": "fZ9knYyxseQHJTzhMtc="
					},
					"name": "UC32 - Notify Affected Licensees (consent withdrawn)",
					"documentation": "when consent is withdrawn for a work that buyers already licensed the platform tells those buyers that they must confirm removal within 30 days",
					"visibility": "public",
					"isAbstract": false,
					"isFinalSpecialization": false,
					"isLeaf": false
				},
				{
					"_type": "UMLUseCase",
					"_id": "3k4168Rm6xsQrr7qy0I=",
					"_parent": {
						"$ref": "fZ9knYyxseQHJTzhMtc="
					},
					"name": "UC33 - Refer Request to Legal Team (price over EGP 1m)",
					"documentation": "when a dataset request price is above 1 million egp the platform sends it to the legal team for contract negotiation",
					"visibility": "public",
					"isAbstract": false,
					"isFinalSpecialization": false,
					"isLeaf": false
				},
				{
					"_type": "UMLUseCase",
					"_id": "790BAMD1wh9YfAlbR9A=",
					"_parent": {
						"$ref": "fZ9knYyxseQHJTzhMtc="
					},
					"name": "UC34 - Authorize Paid Delivery (payment confirmed)",
					"documentation": "when the payment is confirmed the platform allows the ai buyer to download the licensed dataset",
					"visibility": "public",
					"isAbstract": false,
					"isFinalSpecialization": false,
					"isLeaf": false
				},
				{
					"_type": "UMLUseCase",
					"_id": "/TcMuoVk16RbBJrhtXk=",
					"_parent": {
						"$ref": "fZ9knYyxseQHJTzhMtc="
					},
					"name": "UC35 - Hold Disputed Royalties (ownership disputed)",
					"documentation": "when the ownership of a work becomes disputed the platform holds the unpaid royalties of that work so nobody gets paid by mistake",
					"visibility": "public",
					"isAbstract": false,
					"isFinalSpecialization": false,
					"isLeaf": false
				},
				{
					"_type": "UMLUseCase",
