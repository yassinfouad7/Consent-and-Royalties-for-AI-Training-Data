						"$ref": "fZ9knYyxseQHJTzhMtc="
					},
					"name": "UC23 - Report Missing Removal Confirmations",
					"documentation": "the executive director checks which buyers did not confirm removal after a withdrawal and the platform lists them",
					"visibility": "public",
					"isAbstract": false,
					"isFinalSpecialization": false,
					"isLeaf": false
				},
				{
					"_type": "UMLUseCase",
					"_id": "MfOho77WIFUyBOroU+A=",
