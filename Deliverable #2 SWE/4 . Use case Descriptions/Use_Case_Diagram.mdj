					"_parent": {
						"$ref": "fZ9knYyxseQHJTzhMtc="
					},
					"name": "UC38 - Block Minor-Owned AI Licenses (member under 18)",
					"documentation": "when a member is under 18 the platform blocks their works from being licensed for ai training",
					"visibility": "public",
					"isAbstract": false,
					"isFinalSpecialization": false,
					"isLeaf": false
				},
