					"_parent": {
						"$ref": "fZ9knYyxseQHJTzhMtc="
					},
					"name": "UC37 - Restrict Unreleased Work Visibility (work unreleased)",
					"documentation": "when a work is marked as unreleased the platform hides it from everyone except its owner",
					"visibility": "public",
					"isAbstract": false,
					"isFinalSpecialization": false,
					"isLeaf": false
				},
