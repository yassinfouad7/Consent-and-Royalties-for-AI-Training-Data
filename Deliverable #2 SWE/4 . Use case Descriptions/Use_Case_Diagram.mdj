					"_parent": {
						"$ref": "fZ9knYyxseQHJTzhMtc="
					},
					"name": "UC36 - Update Held Royalty Status (dispute settled)",
					"documentation": "when the dispute is settled the platform updates the held royalties so they can be paid to the right owner",
					"visibility": "public",
					"isAbstract": false,
					"isFinalSpecialization": false,
					"isLeaf": false
				},
				{
					"_type": "UMLUseCase",
