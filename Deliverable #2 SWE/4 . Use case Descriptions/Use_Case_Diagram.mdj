						"$ref": "fZ9knYyxseQHJTzhMtc="
					},
					"name": "UC24 - Report Ownership Disputes",
					"documentation": "the executive director checks how many works are under ownership dispute and the platform shows the number and the list of works",
					"visibility": "public",
					"isAbstract": false,
					"isFinalSpecialization": false,
					"isLeaf": false
				},
				{
					"_type": "UMLUseCase",
					"_id": "4JNDi7/bJhqgIbHdxug=",
					"_parent": {
						"$ref": "fZ9knYyxseQHJTzhMtc="
					},
					"name": "UC25 - Record Collective Minimum Price",
					"documentation": "a group of creators agree on a minimum price for their works and the platform saves it for those works",
					"visibility": "public",
					"isAbstract": false,
					"isFinalSpecialization": false,
					"isLeaf": false
				},
				{
					"_type": "UMLUseCase",
					"_id": "QGVQPabHBIppWCbFT3U=",
					"_parent": {
						"$ref": "fZ9knYyxseQHJTzhMtc="
					},
					"name": "UC26 - Audit Licensed Data Usage",
					"documentation": "a regulator asks to check if an ai company model used licensed data and the platform gives the license and delivery and usage records of that company",
