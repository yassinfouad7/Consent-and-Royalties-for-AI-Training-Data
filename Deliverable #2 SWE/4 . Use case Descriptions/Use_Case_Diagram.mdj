				{
					"_type": "UMLUseCase",
					"_id": "5VtVJOVVbsddjGMEMbc=",
					"_parent": {
						"$ref": "fZ9knYyxseQHJTzhMtc="
					},
					"name": "UC01 - Register and Verify Creator",
					"documentation": "the creator signs up and gives their identity details then the platform checks them and marks the creator as verified so they can start adding works",
					"visibility": "public",
					"isAbstract": false,
					"isFinalSpecialization": false,
					"isLeaf": false
				},
				{
					"_type": "UMLUseCase",
					"_id": "CfvU3u1ieUDugebJBlQ=",
					"_parent": {
						"$ref": "fZ9knYyxseQHJTzhMtc="
					},
					"name": "UC02 - Register Work",
					"documentation": "the creator uploads a work or adds a link to it and says they own it then the platform sends it to the fingerprint service to check that nobody else owns it before it can be listed",
					"visibility": "public",
					"isAbstract": false,
					"isFinalSpecialization": false,
					"isLeaf": false
				},
				{
					"_type": "UMLUseCase",
					"_id": "tBQH4OzuXAtz2pIJD+8=",
					"_parent": {
						"$ref": "fZ9knYyxseQHJTzhMtc="
					},
					"name": "UC03 - Record Work Consent",
					"documentation": "the creator picks which ai uses are allowed for one of their works like research only or commercial training or style fine tuning and the platform saves this consent with its start date",
					"visibility": "public",
					"isAbstract": false,
					"isFinalSpecialization": false,
					"isLeaf": false
				},
				{
					"_type": "UMLUseCase",
					"_id": "hGRORTcBvCz1i2rSoOM=",
					"_parent": {
						"$ref": "fZ9knYyxseQHJTzhMtc="
					},
					"name": "UC04 - Record Voice-Cloning Consent",
					"documentation": "the creator gives the extra signed consent and the recorded video statement that voice cloning needs and the platform saves them with the work",
					"visibility": "public",
					"isAbstract": false,
					"isFinalSpecialization": false,
					"isLeaf": false
				},
				{
					"_type": "UMLUseCase",
					"_id": "DGb12lWrhzoeMEHuWsc=",
					"_parent": {
						"$ref": "fZ9knYyxseQHJTzhMtc="
					},
					"name": "UC05 - Withdraw Work Consent",
					"documentation": "the creator takes back permission for a work and an ai use and the platform stops it for new licenses and keeps the old consent in the history",
					"visibility": "public",
					"isAbstract": false,
					"isFinalSpecialization": false,
					"isLeaf": false
				},
				{
					"_type": "UMLUseCase",
					"_id": "JKfNSJlwIwcS5wxM+Vg=",
					"_parent": {
						"$ref": "fZ9knYyxseQHJTzhMtc="
					},
					"name": "UC06 - Maintain Creator Price",
					"documentation": "the creator adds or changes the licensing price of a work and the platform saves the new price so it is used when datasets are priced",
					"visibility": "public",
					"isAbstract": false,
					"isFinalSpecialization": false,
					"isLeaf": false
				},
				{
					"_type": "UMLUseCase",
					"_id": "ylBt8Y+Y051apkPp4JU=",
					"_parent": {
						"$ref": "fZ9knYyxseQHJTzhMtc="
					},
					"name": "UC07 - Register Publisher Catalog",
					"documentation": "the publisher sends a catalog with works from many authors and the platform saves the works as waiting until each author confirms them",
					"visibility": "public",
					"isAbstract": false,
					"isFinalSpecialization": false,
					"isLeaf": false
				},
				{
					"_type": "UMLUseCase",
					"_id": "gULmI3MWGzNytEwLri8=",
					"_parent": {
						"$ref": "fZ9knYyxseQHJTzhMtc="
					},
					"name": "UC08 - Record Author Confirmation",
					"documentation": "the author confirms that a work sent by their publisher is really theirs and the platform marks the work as confirmed",
					"visibility": "public",
					"isAbstract": false,
					"isFinalSpecialization": false,
					"isLeaf": false
				},
				{
					"_type": "UMLUseCase",
					"_id": "TPMKYqwjtDt5AJcwRT0=",
					"_parent": {
						"$ref": "fZ9knYyxseQHJTzhMtc="
					},
					"name": "UC09 - Browse Eligible Catalog",
					"documentation": "the ai buyer searches the catalog by type and language and dialect and allowed use and the platform only shows works that can be licensed",
					"visibility": "public",
					"isAbstract": false,
					"isFinalSpecialization": false,
					"isLeaf": false
				},
				{
					"_type": "UMLUseCase",
					"_id": "/dRCHQFs275lYHzbup4=",
					"_parent": {
						"$ref": "fZ9knYyxseQHJTzhMtc="
					},
					"name": "UC10 - Submit Dataset Request",
					"documentation": "the ai buyer picks works and sends a dataset request and the platform calculates the price from the creator prices and the size",
					"visibility": "public",
					"isAbstract": false,
					"isFinalSpecialization": false,
					"isLeaf": false
				},
				{
					"_type": "UMLUseCase",
					"_id": "/pkjUb6KMHjbxf9zwig=",
					"_parent": {
						"$ref": "fZ9knYyxseQHJTzhMtc="
					},
					"name": "UC11 - Manage Contract Negotiation",
					"documentation": "the legal team negotiates the contract for a large dataset request with the ai buyer and records the agreed terms in the platform",
					"visibility": "public",
					"isAbstract": false,
					"isFinalSpecialization": false,
					"isLeaf": false
				},
				{
					"_type": "UMLUseCase",
					"_id": "Z0V7aPMv3gLu7kk+ZZQ=",
					"_parent": {
						"$ref": "fZ9knYyxseQHJTzhMtc="
					},
					"name": "UC12 - Record License Payment",
					"documentation": "the ai buyer pays for the dataset license and the platform records the payment for that request",
					"visibility": "public",
					"isAbstract": false,
					"isFinalSpecialization": false,
					"isLeaf": false
				},
				{
					"_type": "UMLUseCase",
					"_id": "Gr/Q2ZRilmeniYX1Dik=",
					"_parent": {
						"$ref": "fZ9knYyxseQHJTzhMtc="
					},
					"name": "UC13 - Deliver Licensed Dataset",
					"documentation": "after payment the ai buyer downloads the licensed dataset and the platform puts the buyer watermark on each file and lets the download continue if it stops and logs it",
					"visibility": "public",
					"isAbstract": false,
					"isFinalSpecialization": false,
					"isLeaf": false
				},
				{
					"_type": "UMLUseCase",
					"_id": "4ihaevRew7pC8hgqEi4=",
					"_parent": {
						"$ref": "fZ9knYyxseQHJTzhMtc="
					},
					"name": "UC14 - Record Buyer Usage",
					"documentation": "the ai buyer reports how the licensed works were used and the platform saves the report so it can be used for royalties",
					"visibility": "public",
					"isAbstract": false,
					"isFinalSpecialization": false,
					"isLeaf": false
				},
				{
					"_type": "UMLUseCase",
					"_id": "Rz0WEiZEG+yu4WA49yg=",
					"_parent": {
						"$ref": "fZ9knYyxseQHJTzhMtc="
					},
					"name": "UC15 - Record Removal Confirmation",
					"documentation": "the ai buyer confirms in writing that withdrawn works were removed from future training sets and the platform saves the confirmation",
					"visibility": "public",
					"isAbstract": false,
					"isFinalSpecialization": false,
					"isLeaf": false
				},
				{
					"_type": "UMLUseCase",
					"_id": "qwEIEgtz/Yx3MxFeysg=",
					"_parent": {
						"$ref": "fZ9knYyxseQHJTzhMtc="
					},
					"name": "UC16 - Register Misuse Report",
					"documentation": "the creator reports that a company may have used their work without permission and the platform saves the report for the rights officer",
					"visibility": "public",
					"isAbstract": false,
					"isFinalSpecialization": false,
					"isLeaf": false
				},
				{
					"_type": "UMLUseCase",
					"_id": "E0XXQFoRNq/4VG5NMzQ=",
					"_parent": {
						"$ref": "fZ9knYyxseQHJTzhMtc="
					},
					"name": "UC17 - Review Fingerprint Conflict",
					"documentation": "the rights officer checks a work that was held because of a fingerprint match and records if the upload can go on or not",
					"visibility": "public",
					"isAbstract": false,
					"isFinalSpecialization": false,
					"isLeaf": false
				},
				{
					"_type": "UMLUseCase",
					"_id": "ASYoOLQQx6TYTmH5QF4=",
					"_parent": {
						"$ref": "fZ9knYyxseQHJTzhMtc="
					},
					"name": "UC18 - Investigate Misuse",
					"documentation": "the rights officer looks into a misuse report and records the steps and the result of the investigation",
					"visibility": "public",
					"isAbstract": false,
					"isFinalSpecialization": false,
					"isLeaf": false
				},
				{
					"_type": "UMLUseCase",
					"_id": "KJVhq2ZpJOL+wCKdleU=",
					"_parent": {
						"$ref": "fZ9knYyxseQHJTzhMtc="
					},
					"name": "UC19 - Open Ownership Dispute",
					"documentation": "a creator or another claimant says the recorded owner of a work is wrong and the platform opens an ownership dispute for that work",
					"visibility": "public",
					"isAbstract": false,
					"isFinalSpecialization": false,
					"isLeaf": false
				},
				{
					"_type": "UMLUseCase",
					"_id": "ONfMYoSd2+zFJGxMoHk=",
					"_parent": {
						"$ref": "fZ9knYyxseQHJTzhMtc="
					},
					"name": "UC20 - Resolve Ownership Dispute",
					"documentation": "the rights officer records the final decision of an ownership dispute and the platform updates the owner of the work if needed",
					"visibility": "public",
					"isAbstract": false,
					"isFinalSpecialization": false,
					"isLeaf": false
				},
				{
					"_type": "UMLUseCase",
					"_id": "Noob07GShflNgmkNJ38=",
					"_parent": {
						"$ref": "fZ9knYyxseQHJTzhMtc="
					},
					"name": "UC21 - Report Content Demand",
					"documentation": "the executive director asks which types of content and dialects are requested the most and the platform shows a report",
					"visibility": "public",
					"isAbstract": false,
					"isFinalSpecialization": false,
					"isLeaf": false
				},
				{
					"_type": "UMLUseCase",
					"_id": "cGBJ3+Ucjjq9U/vnHgY=",
