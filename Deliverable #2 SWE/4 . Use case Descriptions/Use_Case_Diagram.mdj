					"_parent": {
						"$ref": "fZ9knYyxseQHJTzhMtc="
					},
					"name": "UC28 - Suspend Non-Compliant Buyer (30 days with no confirmation)",
					"documentation": "when 30 days pass after a withdrawal and the buyer still did not confirm removal the platform suspends that buyer",
					"visibility": "public",
					"isAbstract": false,
					"isFinalSpecialization": false,
					"isLeaf": false
				},
				{
					"_type": "UMLUseCase",
					"_id": "7if76gUVRoCKckHEWzc=",
					"_parent": {
						"$ref": "fZ9knYyxseQHJTzhMtc="
					},
					"name": "UC29 - Hold Work for Rights Review (possible ownership conflict)",
					"documentation": "when the fingerprint check finds a possible match with a different owner the platform holds the work and sends it to the rights officer to review",
					"visibility": "public",
					"isAbstract": false,
					"isFinalSpecialization": false,
					"isLeaf": false
				},
