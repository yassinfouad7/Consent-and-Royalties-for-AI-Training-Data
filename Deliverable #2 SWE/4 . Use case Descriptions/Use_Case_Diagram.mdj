						"$ref": "fZ9knYyxseQHJTzhMtc="
					},
					"name": "UC22 - Report Quarterly Creator Earnings",
					"documentation": "the executive director asks how much each creator earned in a quarter and the platform shows the earnings of each creator",
					"visibility": "public",
					"isAbstract": false,
					"isFinalSpecialization": false,
					"isLeaf": false
				},
				{
					"_type": "UMLUseCase",
					"_id": "TeUlPkQkK+QWXhI2tzA=",
